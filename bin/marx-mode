#!/bin/sh
# Hand the conversation to another model: `marx-mode think|labour "<note for the next model>"`.
# The marx router reads this command back from the chat history and routes the next turns
# to that mode's model. The command itself only acknowledges.
mode="$1"; shift
case "$mode" in
  think|labour) echo "marx-mode: next turns go to the ${mode} model. Note: $*" ;;
  *) echo "usage: marx-mode think|labour \"<note>\"" >&2; exit 2 ;;
esac
